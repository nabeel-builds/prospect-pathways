# ---------------------------------------------------------------------------
# RicozProspect environment variables
# Copy this file to .env.local and fill in real values. Never commit .env.local
# ---------------------------------------------------------------------------

# MongoDB connection string. Local: mongodb://127.0.0.1:27017/ricozprospect
# Atlas: mongodb+srv://<user>:<pass>@<cluster>/ricozprospect?retryWrites=true&w=majority
MONGODB_URI=

# Secret used to SIGN and VERIFY short-lived access tokens (JWT).
# Generate with: openssl rand -hex 64
ACCESS_TOKEN_SECRET=

# Secret used to SIGN and VERIFY long-lived refresh tokens (JWT).
# MUST be different from ACCESS_TOKEN_SECRET.
REFRESH_TOKEN_SECRET=

# Access token lifetime. Keep it short so a stolen token expires fast.
ACCESS_TOKEN_EXPIRES_IN=15m

# Refresh token lifetime. Controls how long a session can be kept alive.
REFRESH_TOKEN_EXPIRES_IN=7d

# Public base URL of the app, used for absolute links/redirects.
NEXT_PUBLIC_APP_URL=http://localhost:3000
